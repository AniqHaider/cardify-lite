# Cardify backend. Copy to .env (start.sh does this for you).
PORT=4100
HOST=127.0.0.1

# Optional. Leave unset to keep settings in memory (resets on restart).
# DATABASE_URL=mysql://root@127.0.0.1:3306/cardify_app

# Guards the /cardify/admin/* routes. REQUIRED (min 8 chars): the server refuses
# to start without it, so an unset value can never mean "open". Change this
# before exposing the backend anywhere.
ADMIN_API_KEY=change-me-please

# Comma-separated origins allowed to call /cardify/admin/* from a browser.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173

# Where the built SDK bundles live (served at /cardify/sdk/*).
SDK_DIR=../sdk/dist
